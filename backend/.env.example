# ── Servidor ─────────────────────────────────────────────
PORT=3000
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h

# ── Base de datos ─────────────────────────────────────────
# DB_TYPE=sqlite | postgres
DB_TYPE=sqlite
SQLITE_FILE=./data/sisven.db
# Sincroniza esquema automáticamente (recomendado sólo en desarrollo/SQLite)
DB_SYNC=true

# Para PostgreSQL en producción:
# DATABASE_URL=postgres://usuario:clave@localhost:5432/sisven
# ó variables sueltas:
DB_HOST=localhost
DB_PORT=5432
DB_USER=sisven
DB_PASSWORD=sisven
DB_NAME=sisven
# Activar RLS del DDL como segunda capa (pendiente de fase producción)

# ── Seeds ────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@sisven.local
SEED_ADMIN_PASSWORD=Admin123!
